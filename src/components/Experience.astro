---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCIE = [
  {
    date: "Actualmente...",
    title: "Desarrollador web fullstack",
    company: "Freelancer",
    description:
      "Como desarrollador full stack freelance, he llevado múltiples proyectos desde la idealización hasta la puesta en producción. Mi proyecto principal es InMas Soft, una aplicación de gestión de inventarios que construí desde cero, ha logrado una gran aceptación en el mercado, con más de 10 clientes puntuales en menos de 4 meses. Mi experiencia también incluye el desarrollo de aplicaciones como MeRewards, GestCad y ChatCubano, así como la creación de automatizaciones, landing pages y el mantenimiento de diversas plataformas web.",
    link: "https://inmas.vercel.app",
  },
  {
    date: "Octubre, 2023",
    title: "Desarrollador web frontend",
    company: "Avangenio SURL",
    description:
      "Como pasante, me integré a un equipo de desarrollo para trabajar en proyectos reales. Fui responsable de la maquetación y la optimización de código, además de la integración de componentes. Esta experiencia me ayudó a desarrollar un enfoque colaborativo y a ganar experiencia en la creación de aplicaciones web robustas.",
    link: "https://avangenio.com/",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCIE.map((experiencie) => (
      <li class="">
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>
